# Database
DATABASE_URL=postgresql+asyncpg://flowpilot:flowpilot@localhost:5432/flowpilot
DATABASE_URL_SYNC=postgresql://flowpilot:flowpilot@localhost:5432/flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=flowpilot
POSTGRES_DB=flowpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional LLM / Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
USE_MOCK_LLM=true
USE_MOCK_EMBEDDINGS=true

# Execution
DEFAULT_NODE_TIMEOUT_SECONDS=60
DEFAULT_MAX_RETRIES=2
